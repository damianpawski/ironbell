<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Minimal API host. Feature slices live in Features/; the published client is
       served from this container (same origin), wired up in a later step. -->

  <PropertyGroup>
    <!-- Local secrets use the same key names the deployed vault will use. -->
    <UserSecretsId>ironbell-api-5f3a1c9e-2b47-4d80-9a16-c7e5b0d84f21</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ironbell.Domain\Ironbell.Domain.csproj" />
    <ProjectReference Include="..\Ironbell.Infrastructure\Ironbell.Infrastructure.csproj" />
    <!-- The client is served from this host so client and API share an origin: no CORS story to
         design, and the refresh cookie stays first-party. -->
    <ProjectReference Include="..\Ironbell.Client\Ironbell.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Slices and the dispatcher are internal; the tests exercise them directly. -->
    <InternalsVisibleTo Include="Ironbell.Api.Tests" />
  </ItemGroup>

</Project>

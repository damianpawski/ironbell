<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- Standalone Blazor WebAssembly PWA. Standalone (not a Blazor Web App host) is a
       hard requirement for offline training mode. -->

  <PropertyGroup>
    <!-- Off deliberately. Placeholder substitution injects an inline <script type="importmap">
         holding the fingerprinted asset names, and an inline script cannot be allowed by a strict
         CSP without 'unsafe-inline', a nonce, or a hash. A hash is not viable here: the map's
         content changes per build and even differs between Development and Production, since
         Development adds hot-reload entries. Removing the inline script is simpler and keeps the
         policy identical everywhere. Cache correctness for the PWA comes from the service worker's
         asset manifest, which is the mechanism that actually matters offline. -->
    <OverrideHtmlAssetPlaceholders>false</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <!-- Drops the ICU data from the payload, which is worth over a megabyte against the bundle
         budget. Safe here because the client formats UTC instants and invariant numbers only.
         It is set per project rather than repo-wide: SqlClient cannot run under invariant mode. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.BrowserConsole" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ironbell.Domain\Ironbell.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

</Project>

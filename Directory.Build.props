<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Deliberately NOT InvariantGlobalization here. Microsoft.Data.SqlClient throws
         "Globalization Invariant Mode is not supported" on first connect, so it cannot be a
         solution-wide default. Npgsql tolerates it, which is exactly why this hid until the
         first real SQL Server connection. The WASM client opts in on its own. -->
  </PropertyGroup>

  <!-- Warnings are errors from commit one. Cheap now, miserable to retrofit. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- IDE0005 (unused usings) is only reported at build when a doc file is generated.
         CS1591 (missing XML comment) is the unwanted side effect, so it is suppressed. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Deterministic output, but only pin source paths on CI. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Ironbell</Product>
    <Authors>Ironbell</Authors>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

</Project>

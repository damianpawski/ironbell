# Keep the build context small and, more importantly, keep host build output from leaking into
# the image. Copying a host bin/ in would produce a container built from artefacts nobody can
# reproduce — the image must come from source every time.
**/bin/
**/obj/
artifacts/

.git/
.github/
.vs/
.idea/
.config/

docs/
scripts/
tests/
*.md
compose.yaml
.gitattributes
.gitignore
.dockerignore
Dockerfile

# NOT excluded, deliberately: .editorconfig carries the analyser severities, including the
# suppressions for EF's generated migrations. With TreatWarningsAsErrors, omitting it does not
# relax the build -- it breaks it, and only inside the container.
